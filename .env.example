# =============================================================================
# DIGITAL PEAK — Environment Variables Template
# Configura queste variabili nel pannello "Environment Variables" del tuo progetto su Vercel
# =============================================================================

# 1. Supabase (Database)
# Recupera questi dati dalla dashboard del tuo progetto Supabase: Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 2. Resend (Email Gateway)
# Crea un account gratuito su https://resend.com e genera una API Key
RESEND_API_KEY=re_123456789...

# Mittente email (in fase di test usa onboarding@resend.dev, poi configurerai il tuo dominio es. info@digitalpeak.it)
RESEND_FROM_EMAIL=Digital Peak <onboarding@resend.dev>

# Destinatari delle notifiche dei nuovi lead (separati da virgola)
NOTIFICATION_EMAILS=giulianoguerriero@gmail.com,marco.guerriero1994@gmail.com
